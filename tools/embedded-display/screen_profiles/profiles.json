    "flash": "8MB",
    "psram": "8MB",
    "notes": [
      "Avoid GPIO19 and GPIO20 for LCD signals on ESP32-S3 boards that use native USB.",
      "The LCD modules use write-only SPI in this project; MISO is not connected."
    ],
    "commonGpio": {
      "sclk": 12,
      "mosi": 11,
      "miso": -1,
      "dc": 9,
      "reset": 14,
      "cs": 10,
      "backlight": -1
    }
  },
