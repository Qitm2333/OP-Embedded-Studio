# Screen profile: T042BH-C08-02, 96x54 ST7735P3 TFT on ESP32-C3.
# CONFIG_EXAMPLE_LCD_CONTROLLER_ST7789 is not set
CONFIG_EXAMPLE_LCD_CONTROLLER_ST7735=y
CONFIG_OPENPENCIL_ST7735P3_INIT=y

CONFIG_EXAMPLE_LCD_H_RES=96
CONFIG_EXAMPLE_LCD_V_RES=54
CONFIG_EXAMPLE_LCD_X_GAP=16
CONFIG_EXAMPLE_LCD_Y_GAP=0
# CONFIG_EXAMPLE_LCD_INVERT_COLOR is not set
# CONFIG_EXAMPLE_LCD_MIRROR_X is not set
# CONFIG_EXAMPLE_LCD_MIRROR_Y is not set
# CONFIG_EXAMPLE_LCD_SWAP_XY is not set
CONFIG_EXAMPLE_LCD_RGB_ORDER_BGR=y
CONFIG_EXAMPLE_LCD_PIXEL_CLOCK_HZ=15000000

CONFIG_EXAMPLE_PIN_NUM_SCLK=6
CONFIG_EXAMPLE_PIN_NUM_MOSI=5
CONFIG_EXAMPLE_PIN_NUM_MISO=-1
CONFIG_EXAMPLE_PIN_NUM_LCD_DC=3
CONFIG_EXAMPLE_PIN_NUM_LCD_RST=4
CONFIG_EXAMPLE_PIN_NUM_LCD_CS=7
CONFIG_EXAMPLE_PIN_NUM_LCD_PWR=1
CONFIG_EXAMPLE_PIN_NUM_BK_LIGHT=-1
