# Common ESP32-S3 board defaults shared by all verified LCD profiles.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb_wireless.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_8mb_wireless.csv"

# The ESP32-S3 display board provides 8MB Octal PSRAM. Full-frame RGB565
# buffers for 466x466 panels must live in PSRAM-capable DMA memory.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_EXAMPLE_LCD_PIXEL_CLOCK_HZ=10000000
CONFIG_EXAMPLE_PIN_NUM_SCLK=12
CONFIG_EXAMPLE_PIN_NUM_MOSI=11
CONFIG_EXAMPLE_PIN_NUM_MISO=-1
CONFIG_EXAMPLE_PIN_NUM_LCD_DC=9
CONFIG_EXAMPLE_PIN_NUM_LCD_RST=14
CONFIG_EXAMPLE_PIN_NUM_LCD_CS=10
CONFIG_EXAMPLE_PIN_NUM_BK_LIGHT=-1
CONFIG_EXAMPLE_LCD_BK_LIGHT_ON_LEVEL=1
